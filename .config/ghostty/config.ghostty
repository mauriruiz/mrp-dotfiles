# Ghostty renders; tmux owns sessions, windows and panes.

theme = Catppuccin Mocha

# Lilex is Zed's default editor font (IBM Plex Mono with ligatures). Ghostty
# embeds the Nerd Font symbols, so no patched font is needed.
font-family = Lilex
font-size = 14
font-thicken = true
font-thicken-strength = 110
font-style = Medium
adjust-cell-height = 20%

window-padding-x = 10
window-padding-y = 6
window-padding-balance = true
window-padding-color = extend
macos-window-shadow = false

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
confirm-close-surface = false

# Programs may set the clipboard (OSC 52, e.g. Neovim over SSH); reading it asks.
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = false

# Remote shells get TERM=xterm-256color rather than an xterm-ghostty they lack.
shell-integration-features = ssh-env
