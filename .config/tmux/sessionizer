#!/usr/bin/env bash
# Pick a project and switch to its tmux session, creating it on first use.
# Candidates: running sessions, then zoxide's frecent dirs, then ~/dev/*.
set -euo pipefail

pick=$(
  {
    tmux list-sessions -F '#S' 2>/dev/null || true
    zoxide query -l 2>/dev/null || true
    find "$HOME/dev" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true
  } | awk 'NF && !seen[$0]++' |
    fzf --reverse --no-info --prompt 'project > ' \
      --color 'bg:-1,gutter:-1,pointer:#89b4fa,prompt:#cba6f7,hl:#f9e2af,hl+:#f9e2af'
) || exit 0

if tmux has-session -t "=$pick" 2>/dev/null; then
  target=$pick
else
  target=$(basename "$pick" | tr '.:' '__')
  tmux has-session -t "=$target" 2>/dev/null || tmux new-session -ds "$target" -c "$pick"
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "=$target"
else
  tmux attach-session -t "=$target"
fi
